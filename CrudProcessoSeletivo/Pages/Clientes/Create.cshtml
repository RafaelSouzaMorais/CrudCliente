@page
@model CrudProcessoSeletivo.Pages.Clientes.CreateModel
@{
    ViewData["Title"] = "Novo Cliente";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">@ViewData["Title"]</h2>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Cliente.Nome" class="form-label">Nome Completo</label>
                            <input asp-for="Cliente.Nome" class="form-control" placeholder="Digite o nome completo" />
                            <span asp-validation-for="Cliente.Nome" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Cliente.Email" class="form-label">Email</label>
                            <input asp-for="Cliente.Email" class="form-control" type="email" placeholder="exemplo@email.com" />
                            <span asp-validation-for="Cliente.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Cliente.Telefone" class="form-label">Telefone</label>
                            <input asp-for="Cliente.Telefone" class="form-control" type="number" placeholder="999999999" />
                            <span asp-validation-for="Cliente.Telefone" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Salvar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
