@page "{id:guid}"
@model CrudProcessoSeletivo.Pages.Clientes.DeleteModel
@{
    ViewData["Title"] = "Excluir Cliente";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="mb-0">@ViewData["Title"]</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Atenção!</strong> Tem certeza que deseja excluir este cliente? Esta ação não pode ser desfeita.
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3">ID</dt>
                        <dd class="col-sm-9">@Model.Cliente.Id</dd>

                        <dt class="col-sm-3">Nome</dt>
                        <dd class="col-sm-9">@Model.Cliente.Nome</dd>

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@Model.Cliente.Email</dd>

                        <dt class="col-sm-3">Telefone</dt>
                        <dd class="col-sm-9">@Model.Cliente.Telefone</dd>
                    </dl>

                    <form method="post">
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Confirmar Exclusão
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
